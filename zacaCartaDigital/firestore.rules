rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{collection}/{document} {
      allow read: if collection in ['productos', 'promociones', 'zonasDelivery', 'config'];
      allow write: if collection in ['productos', 'promociones', 'zonasDelivery', 'config']
        && request.auth != null;
    }

    match /clientes/{clienteId} {
      // V1 without customer authentication: anyone who knows a phone number can read or edit that profile.
      allow read, write: if true;
    }
  }
}